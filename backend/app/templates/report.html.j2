<!DOCTYPE html>
{% if rtl %}
<html lang="he" dir="rtl">
{% else %}
<html lang="en" dir="ltr">
{% endif %}
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{ report.company_name }} ({{ report.ticker }}) — Financial Analysis Report</title>
  <style>
    /* ── Page Layout ──────────────────────────────────────────── */
    @page {
      size: A4;
      margin: 20mm;

      @top-center {
        content: "{{ report.company_name }} ({{ report.ticker }}) — Confidential Financial Analysis";
        font-size: 8pt;
        color: #6b7280;
        font-family: sans-serif;
      }

      @bottom-center {
        content: "Page " counter(page) " of " counter(pages);
        font-size: 8pt;
        color: #6b7280;
        font-family: sans-serif;
      }
    }

    /* ── Base Typography ──────────────────────────────────────── */
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      {% if rtl %}
      font-family: 'Arial Hebrew', 'David', 'Simplified Arabic', Arial, sans-serif;
      {% else %}
      font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
      {% endif %}
      font-size: 10pt;
      line-height: 1.55;
      color: #1f2937;
      background: #ffffff;
    }

    h1 { font-size: 20pt; font-weight: 700; color: #111827; margin-bottom: 4px; }
    h2 { font-size: 13pt; font-weight: 700; color: #1e40af; margin: 16px 0 8px; border-bottom: 2px solid #dbeafe; padding-bottom: 4px; }
    h3 { font-size: 11pt; font-weight: 600; color: #374151; margin-bottom: 6px; }
    p  { margin-bottom: 8px; }

    /* ── Layout Utilities ─────────────────────────────────────── */
    .section { margin-bottom: 20px; }

    .two-col {
      display: flex;
      gap: 16px;
      align-items: flex-start;
    }
    .two-col > * { flex: 1; min-width: 0; }

    .no-break { page-break-inside: avoid; }
    .page-break { page-break-before: always; }

    /* ── Header / Badge ───────────────────────────────────────── */
    .report-header {
      border-bottom: 3px solid #1e40af;
      padding-bottom: 12px;
      margin-bottom: 20px;
    }
    .header-top {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 12px;
    }
    .header-meta {
      font-size: 9pt;
      color: #6b7280;
      margin-top: 4px;
    }
    .header-meta span { margin-right: 12px; }

    .badge {
      display: inline-block;
      padding: 4px 12px;
      border-radius: 12px;
      font-size: 9pt;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      white-space: nowrap;
    }
    .badge-positive  { background: #dcfce7; color: #166534; }
    .badge-negative  { background: #fee2e2; color: #991b1b; }
    .badge-mixed     { background: #f1f5f9; color: #334155; }
    .badge-neutral   { background: #f1f5f9; color: #334155; }

    /* ── Summary Box ──────────────────────────────────────────── */
    .summary-box {
      background: #eff6ff;
      {% if rtl %}
      border-right: 4px solid #1e40af;
      {% else %}
      border-left: 4px solid #1e40af;
      {% endif %}
      padding: 10px 14px;
      font-style: italic;
      color: #1e3a5f;
      border-radius: 4px;
      margin-bottom: 20px;
    }

    /* ── Data Tables ──────────────────────────────────────────── */
    .data-grid {
      width: 100%;
      border-collapse: collapse;
      font-size: 9.5pt;
      margin-bottom: 10px;
    }
    .data-grid th {
      background: #1e40af;
      color: #ffffff;
      padding: 6px 10px;
      {% if rtl %}
      text-align: right;
      {% else %}
      text-align: left;
      {% endif %}
      font-weight: 600;
    }
    .data-grid td {
      padding: 5px 10px;
      border-bottom: 1px solid #e5e7eb;
    }
    .data-grid tr:nth-child(even) td { background: #f9fafb; }
    .data-grid td:last-child {
      {% if rtl %}
      text-align: left;
      {% else %}
      text-align: right;
      {% endif %}
      font-weight: 500;
    }

    /* ── Lists (Strengths / Risks) ────────────────────────────── */
    ul {
      {% if rtl %}
      padding-right: 18px;
      padding-left: 0;
      {% else %}
      padding-left: 18px;
      {% endif %}
      margin-bottom: 8px;
    }
    ul li { margin-bottom: 4px; }

    /* ── Case Boxes ───────────────────────────────────────────── */
    .case-box {
      border: 1px solid #e5e7eb;
      border-radius: 6px;
      padding: 12px;
      margin-bottom: 10px;
    }
    .case-box.bull { border-top: 4px solid #16a34a; }
    .case-box.bear { border-top: 4px solid #dc2626; }
    .case-box .thesis {
      font-style: italic;
      color: #374151;
      margin-bottom: 8px;
    }

    /* ── Deep Narrative ───────────────────────────────────────── */
    .narrative-para { margin-bottom: 10px; text-align: justify; }

    /* ── Sentiment Table ──────────────────────────────────────── */
    .sentiment-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 9.5pt;
      margin-bottom: 10px;
    }
    .sentiment-table th {
      background: #374151;
      color: #f9fafb;
      padding: 6px 10px;
      {% if rtl %}
      text-align: right;
      {% else %}
      text-align: left;
      {% endif %}
    }
    .sentiment-table td {
      padding: 5px 10px;
      border-bottom: 1px solid #e5e7eb;
    }
    .sentiment-table tr:nth-child(even) td { background: #f9fafb; }

    /* ── Footer ───────────────────────────────────────────────── */
    .report-footer {
      margin-top: 24px;
      padding-top: 10px;
      border-top: 1px solid #d1d5db;
      font-size: 7.5pt;
      color: #9ca3af;
      line-height: 1.4;
    }
  </style>
</head>
<body>

  {# ── 1. HEADER ─────────────────────────────────────────────── #}
  <div class="report-header section no-break">
    <div class="header-top">
      <div>
        <h1>{{ report.company_name }}</h1>
        <div class="header-meta">
          <span><strong>Ticker:</strong> {{ report.ticker }}</span>
          {% if report.data_snapshot.overview.sector %}
          <span><strong>Sector:</strong> {{ report.data_snapshot.overview.sector }}</span>
          {% endif %}
          {% if report.data_snapshot.overview.industry %}
          <span><strong>Industry:</strong> {{ report.data_snapshot.overview.industry }}</span>
          {% endif %}
        </div>
        <div class="header-meta" style="margin-top: 2px;">
          <span><strong>Model:</strong> {{ report.model_used }}</span>
        </div>
      </div>
      <div>
        <span class="badge badge-{{ report.overall_view.value | lower }}">
          {{ report.overall_view.value | upper }}
        </span>
      </div>
    </div>
  </div>

  {# ── 2. ONE-LINE SUMMARY ───────────────────────────────────── #}
  {% if report.one_line_summary %}
  <div class="summary-box section">
    {{ report.one_line_summary }}
  </div>
  {% endif %}

  {# ── 3. MARKET DATA SNAPSHOT ───────────────────────────────── #}
  <div class="section no-break">
    <h2>Market Data Snapshot</h2>
    <div class="two-col">

      {# Table 1: Price & Valuation #}
      <table class="data-grid">
        <thead>
          <tr><th colspan="2">Price &amp; Valuation</th></tr>
        </thead>
        <tbody>
          <tr>
            <td>Price</td>
            <td>
              {% if report.data_snapshot.quote.price %}
                ${{ "%.2f"|format(report.data_snapshot.quote.price|float) }}
                {% if report.data_snapshot.quote.change_percent and report.data_snapshot.quote.change_percent != 0 %}
                  {% if report.data_snapshot.quote.change_percent > 0 %}
                    <span style="color:#16a34a">(+{{ "%.2f"|format(report.data_snapshot.quote.change_percent|float) }}%)</span>
                  {% else %}
                    <span style="color:#dc2626">({{ "%.2f"|format(report.data_snapshot.quote.change_percent|float) }}%)</span>
                  {% endif %}
                {% endif %}
              {% else %}N/A{% endif %}
            </td>
          </tr>
          <tr>
            <td>52W High</td>
            <td>{% if report.data_snapshot.overview.week_52_high %}${{ "%.2f"|format(report.data_snapshot.overview.week_52_high|float) }}{% else %}N/A{% endif %}</td>
          </tr>
          <tr>
            <td>52W Low</td>
            <td>{% if report.data_snapshot.overview.week_52_low %}${{ "%.2f"|format(report.data_snapshot.overview.week_52_low|float) }}{% else %}N/A{% endif %}</td>
          </tr>
          <tr>
            <td>Market Cap</td>
            <td>
              {% if report.data_snapshot.overview.market_capitalization %}
                ${{ "{:,.0f}".format(report.data_snapshot.overview.market_capitalization) }}
              {% else %}N/A{% endif %}
            </td>
          </tr>
          <tr>
            <td>P/E Ratio</td>
            <td>{% if report.data_snapshot.overview.pe_ratio %}{{ "%.2f"|format(report.data_snapshot.overview.pe_ratio|float) }}{% else %}N/A{% endif %}</td>
          </tr>
          <tr>
            <td>EPS</td>
            <td>{% if report.data_snapshot.overview.eps %}${{ "%.2f"|format(report.data_snapshot.overview.eps|float) }}{% else %}N/A{% endif %}</td>
          </tr>
        </tbody>
      </table>

      {# Table 2: Financial Metrics #}
      <table class="data-grid">
        <thead>
          <tr><th colspan="2">Financial Metrics</th></tr>
        </thead>
        <tbody>
          {% set metrics = report.data_snapshot.financial_metrics %}
          <tr>
            <td>Revenue TTM</td>
            <td>{{ metrics.get("Revenue TTM", "N/A") }}</td>
          </tr>
          <tr>
            <td>Gross Margin</td>
            <td>{{ metrics.get("Gross Margin", "N/A") }}</td>
          </tr>
          <tr>
            <td>Op. Margin</td>
            <td>{{ metrics.get("Operating Margin", metrics.get("Op. Margin", "N/A")) }}</td>
          </tr>
          <tr>
            <td>Net Margin</td>
            <td>{{ metrics.get("Net Margin", "N/A") }}</td>
          </tr>
          <tr>
            <td>D/E Ratio</td>
            <td>{{ metrics.get("D/E", metrics.get("Debt/Equity", "N/A")) }}</td>
          </tr>
          <tr>
            <td>ROE</td>
            <td>{{ metrics.get("ROE", "N/A") }}</td>
          </tr>
        </tbody>
      </table>

    </div>

    {# Supplemental: dump remaining financial_metrics keys not already shown #}
    {% set shown_keys = ["Revenue TTM", "Gross Margin", "Operating Margin", "Op. Margin", "Net Margin", "D/E", "Debt/Equity", "ROE"] %}
    {% set extra = [] %}
    {% for k, v in metrics.items() if k not in shown_keys %}
      {% if extra.append({"k": k, "v": v}) %}{% endif %}
    {% endfor %}
    {% if extra %}
    <table class="data-grid" style="margin-top:6px;">
      <thead><tr><th colspan="2">Additional Metrics</th></tr></thead>
      <tbody>
        {% for item in extra %}
        <tr>
          <td>{{ item.k }}</td>
          <td>{{ item.v }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
    {% endif %}
  </div>

  {# ── 4. INVESTMENT ANALYSIS ────────────────────────────────── #}
  <div class="section no-break">
    <h2>Investment Analysis</h2>
    <div class="two-col">
      <div>
        <h3 style="color:#16a34a;">&#x2714; Key Strengths</h3>
        {% if report.key_strengths %}
        <ul>
          {% for s in report.key_strengths %}
          <li>{{ s }}</li>
          {% endfor %}
        </ul>
        {% else %}
        <p>No strengths identified.</p>
        {% endif %}
      </div>
      <div>
        <h3 style="color:#dc2626;">&#x26A0; Key Risks</h3>
        {% if report.key_risks %}
        <ul>
          {% for r in report.key_risks %}
          <li>{{ r }}</li>
          {% endfor %}
        </ul>
        {% else %}
        <p>No risks identified.</p>
        {% endif %}
      </div>
    </div>
  </div>

  {# ── 5. BULL & BEAR CASES ──────────────────────────────────── #}
  {% if report.bull_case or report.bear_case %}
  <div class="section no-break">
    <h2>Bull &amp; Bear Cases</h2>
    <div class="two-col">

      {% if report.bull_case %}
      <div class="case-box bull no-break">
        <h3 style="color:#16a34a;">&#x1F4C8; Bull Case</h3>
        {% if report.bull_case.thesis %}
        <p class="thesis">{{ report.bull_case.thesis }}</p>
        {% endif %}
        {% if report.bull_case.key_arguments %}
        <ul>
          {% for arg in report.bull_case.key_arguments %}
          <li>{{ arg }}</li>
          {% endfor %}
        </ul>
        {% endif %}
      </div>
      {% endif %}

      {% if report.bear_case %}
      <div class="case-box bear no-break">
        <h3 style="color:#dc2626;">&#x1F4C9; Bear Case</h3>
        {% if report.bear_case.thesis %}
        <p class="thesis">{{ report.bear_case.thesis }}</p>
        {% endif %}
        {% if report.bear_case.key_arguments %}
        <ul>
          {% for arg in report.bear_case.key_arguments %}
          <li>{{ arg }}</li>
          {% endfor %}
        </ul>
        {% endif %}
      </div>
      {% endif %}

    </div>
  </div>
  {% endif %}

  {# ── 6. INSTITUTIONAL DEEP DIVE ────────────────────────────── #}
  {% if report.deep_narrative %}
  <div class="section page-break">
    <h2>Institutional Deep Dive</h2>
    {% for para in report.deep_narrative.split("\n\n") %}
    {% if para.strip() %}
    <p class="narrative-para">{{ para.strip() }}</p>
    {% endif %}
    {% endfor %}
  </div>
  {% endif %}

  {# ── 7. NEWS SENTIMENT ─────────────────────────────────────── #}
  {% if report.sentiment_snapshot %}
  <div class="section no-break">
    <h2>News Sentiment</h2>
    <table class="sentiment-table">
      <thead>
        <tr>
          <th>Signal</th>
          <th>Confidence Score</th>
          <th>Articles Analyzed</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td>
            {% if report.sentiment_snapshot.overall_sentiment %}
              {% set sv = report.sentiment_snapshot.overall_sentiment.value | lower %}
              {% if sv == "positive" %}
                <span style="color:#16a34a;font-weight:700;">&#x25B2; Positive</span>
              {% elif sv == "negative" %}
                <span style="color:#dc2626;font-weight:700;">&#x25BC; Negative</span>
              {% else %}
                <span style="color:#6b7280;font-weight:700;">&#x25CF; Neutral</span>
              {% endif %}
            {% else %}N/A{% endif %}
          </td>
          <td>
            {% if report.sentiment_snapshot.overall_confidence is not none %}
              {{ "%.0f"|format(report.sentiment_snapshot.overall_confidence * 100) }}%
            {% else %}N/A{% endif %}
          </td>
          <td>
            {% if report.sentiment_snapshot.articles_analyzed is not none %}
              {{ report.sentiment_snapshot.articles_analyzed }}
            {% else %}N/A{% endif %}
          </td>
        </tr>
      </tbody>
    </table>

    {% if report.sentiment_snapshot.news_sentiment %}
      {% set ns = report.sentiment_snapshot.news_sentiment %}
      {% if ns is mapping %}
        {% set summary_text = ns.get("summary", ns.get("analysis", ns.get("text", ""))) %}
        {% if summary_text %}
        <p style="color:#374151;font-size:9.5pt;margin-top:6px;">{{ summary_text }}</p>
        {% endif %}
      {% elif ns is string and ns.strip() %}
        <p style="color:#374151;font-size:9.5pt;margin-top:6px;">{{ ns }}</p>
      {% endif %}
    {% endif %}
  </div>
  {% endif %}

  {# ── FOOTER ────────────────────────────────────────────────── #}
  <div class="report-footer">
    <p>
      <strong>Disclaimer:</strong> This report is generated by an AI-powered financial analysis system and is provided for informational purposes only. It does not constitute financial advice, investment recommendations, or an offer to buy or sell any securities. Always conduct your own due diligence and consult a qualified financial advisor before making investment decisions.
    </p>
    <p style="margin-top:4px;">
      Generated: {{ report.generated_at.strftime("%Y-%m-%d %H:%M UTC") }}
      {% if report.delta_refreshed %}
        &nbsp;&middot;&nbsp; <em>Delta-refreshed from cached report.</em>
      {% endif %}
    </p>
  </div>

</body>
</html>
