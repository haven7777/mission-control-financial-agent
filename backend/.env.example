# ── LLM providers ────────────────────────────────────────────────────────────
# Only one is required.  Groq (free tier) is used by default.
OPENAI_API_KEY=
GROQ_API_KEY=

# ── Financial data ────────────────────────────────────────────────────────────
# Powered by yfinance (Yahoo Finance) — no API key required.

# ── News search ───────────────────────────────────────────────────────────────
TAVILY_API_KEY=

# ── LangSmith tracing (optional but recommended) ─────────────────────────────
# Get a free API key at https://smith.langchain.com
# Set LANGSMITH_TRACING=true to activate; leave blank or omit to disable.
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=financial-agent
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com  # override for self-hosted
